generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id            String   @id @default(cuid())
  employeeCode  String   @unique
  fullName      String
  email         String   @unique
  password      String?
  country       String
  department    String
  jobTitle      String
  salary        Float
  currency      String
  age           Int
  isDeleted     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  startDate     String

@@index([department, isDeleted])
@@index([country, isDeleted])
}
